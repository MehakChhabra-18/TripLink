<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TripLink — Your Ride, Our Connection</title>
  <meta name="description" content="Move through your city with confidence. TripLink helps you plan, book and monitor every journey — built around your arrival time, not just your destination.">
  <meta name="theme-color" content="#4F46E5">
  <meta property="og:title" content="TripLink — Your Ride, Our Connection">
  <meta property="og:description" content="The ride-hailing platform built around your journey. Tell us when you need to arrive.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/triplink.css">
  <style>
    /* ─── Page-specific overrides ─── */
    body { padding-top: 64px; }

    /* ─── Hero Section ─────────────────────────────────────────────── */
    .hero-section {
      position: relative;
      min-height: calc(100vh - 64px);
      display: flex;
      align-items: center;
      overflow: hidden;
      background: linear-gradient(165deg, #FFFFFF 0%, #F5F3FF 40%, #EEF2FF 100%);
    }

    .hero-blob-1 {
      position: absolute;
      width: 700px; height: 700px;
      top: -200px; right: -150px;
      background: radial-gradient(circle at center, rgba(79,70,229,0.1), transparent 65%);
      animation: blob-float 12s ease-in-out infinite;
    }

    .hero-blob-2 {
      position: absolute;
      width: 500px; height: 500px;
      bottom: -100px; left: -100px;
      background: radial-gradient(circle at center, rgba(251,191,36,0.08), transparent 65%);
      animation: blob-float 9s ease-in-out infinite reverse;
    }

    .hero-inner {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
      padding: 80px 24px;
      width: 100%;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      background: rgba(79,70,229,0.08);
      border: 1px solid rgba(79,70,229,0.2);
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--color-primary);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 20px;
    }

    .hero-badge-dot {
      width: 7px; height: 7px;
      background: var(--color-primary);
      border-radius: 50%;
      animation: glow-pulse 2s infinite;
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 5.5vw, 4rem);
      font-weight: 900;
      line-height: 1.05;
      letter-spacing: -0.04em;
      color: var(--color-text-primary);
      margin-bottom: 20px;
    }

    .hero-title .accent-line {
      background: linear-gradient(135deg, #4F46E5 0%, #818CF8 60%, #FBBF24 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-subtitle {
      font-size: 1.0625rem;
      color: var(--color-text-secondary);
      line-height: 1.75;
      max-width: 480px;
      margin-bottom: 36px;
    }

    .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

    .hero-trust {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-top: 40px;
      flex-wrap: wrap;
    }

    .hero-trust-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    .hero-trust-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--color-on-track);
    }

    /* ─── Booking Widget ─────────────────────────────────────────────── */
    .booking-widget {
      background: white;
      border: 1px solid var(--color-border);
      border-radius: 24px;
      padding: 28px;
      box-shadow: 0 24px 80px rgba(79,70,229,0.12), 0 8px 24px rgba(0,0,0,0.06);
      position: relative;
    }

    .booking-widget::before {
      content: "";
      position: absolute;
      inset: -1px;
      border-radius: 25px;
      background: linear-gradient(135deg, rgba(79,70,229,0.15), rgba(251,191,36,0.1));
      z-index: -1;
    }

    .widget-title {
      font-family: var(--font-display);
      font-size: 1.0625rem;
      font-weight: 800;
      color: var(--color-text-primary);
      margin-bottom: 4px;
    }

    .widget-subtitle {
      font-size: 0.825rem;
      color: var(--color-text-muted);
      margin-bottom: 20px;
    }

    .widget-fields {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 16px;
    }

    .widget-field {
      position: relative;
    }

    .widget-field-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 0.9rem;
      pointer-events: none;
      z-index: 1;
    }

    .widget-input {
      width: 100%;
      padding: 12px 14px 12px 38px;
      background: var(--color-surface);
      border: 1.5px solid var(--color-border);
      border-radius: 12px;
      font-family: var(--font-body);
      font-size: 0.875rem;
      color: var(--color-text-primary);
      transition: all 0.2s;
      outline: none;
    }

    .widget-input::placeholder { color: var(--color-text-placeholder); }
    .widget-input:focus {
      border-color: var(--color-primary);
      background: white;
      box-shadow: 0 0 0 3px rgba(79,70,229,0.1);
    }

    .widget-divider {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 0;
      margin: 2px 0;
      z-index: 2;
    }

    .widget-swap-btn {
      position: absolute;
      width: 28px; height: 28px;
      background: white;
      border: 1.5px solid var(--color-border);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }

    .widget-swap-btn:hover {
      border-color: var(--color-primary);
      box-shadow: 0 4px 10px rgba(79,70,229,0.15);
      transform: rotate(180deg);
    }

    .widget-time-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .widget-btn {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
      color: white;
      border: none;
      border-radius: 14px;
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.25s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 8px 24px rgba(79,70,229,0.3);
      margin-top: 14px;
    }

    .widget-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 32px rgba(79,70,229,0.4);
    }

    .widget-btn:active { transform: translateY(0); }

    /* Journey Preview Result */
    .journey-preview {
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid var(--color-border);
      display: none;
    }

    .journey-preview.visible { display: block; animation: fade-up 0.4s ease both; }

    .journey-preview-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 10px;
    }

    .journey-preview-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-bottom: 10px;
    }

    .jp-chip {
      padding: 10px 12px;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 10px;
    }

    .jp-chip-label { font-size: 0.7rem; color: var(--color-text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
    .jp-chip-value { font-family: var(--font-display); font-size: 1rem; font-weight: 800; color: var(--color-text-primary); margin-top: 2px; }

    /* ─── Journey Intelligence Section ────────────────────────────────── */
    .ji-section {
      background: linear-gradient(160deg, #FFFFFF 0%, #F5F3FF 100%);
      padding: 96px 0;
      overflow: hidden;
      position: relative;
    }

    .ji-visual {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .ji-ring {
      position: absolute;
      border-radius: 50%;
      border: 1.5px dashed rgba(79,70,229,0.15);
    }

    .ji-ring-1 { width: 340px; height: 340px; animation: spin 30s linear infinite; }
    .ji-ring-2 { width: 240px; height: 240px; animation: spin 20s linear infinite reverse; }

    .ji-center {
      width: 200px; height: 200px;
      background: linear-gradient(135deg, #4F46E5, #818CF8);
      border-radius: 50%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      box-shadow: 0 20px 60px rgba(79,70,229,0.3);
      color: white;
      text-align: center;
      z-index: 1;
      padding: 20px;
    }

    .ji-center-time {
      font-family: var(--font-display);
      font-size: 2rem;
      font-weight: 900;
      line-height: 1;
    }

    .ji-center-label { font-size: 0.7rem; font-weight: 600; opacity: 0.8; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.08em; }

    .ji-orbit-item {
      position: absolute;
      width: 80px; height: 80px;
      background: white;
      border: 1px solid var(--color-border);
      border-radius: 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      box-shadow: var(--shadow-md);
      font-size: 0.65rem;
      font-weight: 700;
      color: var(--color-text-secondary);
      text-align: center;
      gap: 4px;
    }

    .ji-orbit-item .icon { font-size: 1.3rem; }

    /* Positioned around the circle */
    .ji-orbit-1 { top: 10px;   left: 50%; transform: translateX(-50%) translateX(-160px); }
    .ji-orbit-2 { top: 50%;   right: -10px; transform: translateY(-50%); }
    .ji-orbit-3 { bottom: 10px; left: 50%; transform: translateX(-50%) translateX(80px); }
    .ji-orbit-4 { top: 50%;   left: -10px; transform: translateY(-50%); }

    .ji-features { display: flex; flex-direction: column; gap: 24px; }

    .ji-feature {
      display: flex;
      gap: 16px;
      align-items: flex-start;
      padding: 20px;
      background: white;
      border: 1px solid var(--color-border);
      border-radius: 16px;
      box-shadow: var(--shadow-sm);
      transition: all 0.25s;
    }

    .ji-feature:hover {
      border-color: var(--color-primary-border);
      box-shadow: var(--shadow-md);
      transform: translateX(4px);
    }

    .ji-feature-icon {
      width: 44px; height: 44px;
      background: var(--color-primary-bg);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      flex-shrink: 0;
    }

    .ji-feature-title { font-weight: 700; font-size: 0.95rem; color: var(--color-text-primary); }
    .ji-feature-desc  { font-size: 0.825rem; color: var(--color-text-secondary); margin-top: 4px; line-height: 1.5; }

    /* ─── Services Section ───────────────────────────────────────────── */
    .services-section { background: white; padding: 96px 0; }

    .service-card {
      padding: 28px;
      background: white;
      border: 1px solid var(--color-border);
      border-radius: 20px;
      box-shadow: var(--shadow-sm);
      transition: all 0.3s;
      position: relative;
      overflow: hidden;
    }

    .service-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--color-primary), var(--color-primary-light));
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.35s;
    }

    .service-card:hover {
      border-color: var(--color-primary-border);
      box-shadow: var(--shadow-lg);
      transform: translateY(-4px);
    }

    .service-card:hover::before { transform: scaleX(1); }

    .service-icon {
      font-size: 2.5rem;
      margin-bottom: 16px;
      display: block;
    }

    .service-title { font-weight: 700; font-size: 1rem; margin-bottom: 8px; }
    .service-desc  { font-size: 0.85rem; color: var(--color-text-secondary); line-height: 1.6; }

    .service-tag {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      margin-top: 12px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.7rem;
      font-weight: 700;
      background: var(--color-accent-bg);
      color: var(--color-accent-dark);
      border: 1px solid var(--color-accent-border);
    }

    /* ─── How It Works ───────────────────────────────────────────────── */
    .hiw-section {
      background: linear-gradient(160deg, #F5F3FF 0%, #EEF2FF 100%);
      padding: 96px 0;
    }

    .hiw-steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      position: relative;
      margin-top: 56px;
    }

    .hiw-steps::before {
      content: "";
      position: absolute;
      top: 32px;
      left: calc(12.5% + 24px);
      right: calc(12.5% + 24px);
      height: 2px;
      background: linear-gradient(90deg, var(--color-primary), var(--color-primary-light), var(--color-accent));
    }

    .hiw-step { text-align: center; padding: 0 20px; }

    .hiw-step-number {
      width: 64px; height: 64px;
      margin: 0 auto 20px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 900;
      position: relative;
      z-index: 1;
    }

    .hiw-step:nth-child(1) .hiw-step-number { background: var(--color-primary); color: white; box-shadow: 0 8px 24px rgba(79,70,229,0.35); }
    .hiw-step:nth-child(2) .hiw-step-number { background: #818CF8; color: white; box-shadow: 0 8px 24px rgba(129,140,248,0.35); }
    .hiw-step:nth-child(3) .hiw-step-number { background: var(--color-accent); color: #1a1a1a; box-shadow: 0 8px 24px rgba(251,191,36,0.35); }
    .hiw-step:nth-child(4) .hiw-step-number { background: var(--color-on-track); color: white; box-shadow: 0 8px 24px rgba(16,185,129,0.35); }

    .hiw-step-icon { font-size: 1.75rem; margin-bottom: 8px; }
    .hiw-step-title { font-weight: 700; font-size: 0.95rem; color: var(--color-text-primary); margin-bottom: 6px; }
    .hiw-step-desc { font-size: 0.825rem; color: var(--color-text-secondary); line-height: 1.6; }

    .hiw-highlight {
      background: white;
      border: 1.5px solid var(--color-primary-border);
      border-radius: 20px;
      padding: 24px;
      margin-top: 40px;
      display: flex;
      align-items: center;
      gap: 16px;
      box-shadow: var(--shadow-md);
    }

    .hiw-highlight-icon {
      width: 56px; height: 56px;
      background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.75rem;
      flex-shrink: 0;
      box-shadow: 0 8px 20px rgba(79,70,229,0.25);
    }

    /* ─── Journey Health Demo ────────────────────────────────────────── */
    .health-demo-section { background: white; padding: 96px 0; }

    .health-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 48px; }

    .health-card {
      padding: 28px;
      border-radius: 20px;
      border: 2px solid;
      position: relative;
      overflow: hidden;
    }

    .health-card.on-track {
      background: linear-gradient(135deg, rgba(16,185,129,0.04), rgba(16,185,129,0.01));
      border-color: rgba(16,185,129,0.25);
    }

    .health-card.at-risk {
      background: linear-gradient(135deg, rgba(245,158,11,0.05), rgba(245,158,11,0.01));
      border-color: rgba(245,158,11,0.25);
    }

    .health-card.delayed {
      background: linear-gradient(135deg, rgba(244,63,94,0.04), rgba(244,63,94,0.01));
      border-color: rgba(244,63,94,0.2);
    }

    .health-card-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .health-card.on-track .health-card-badge { background: rgba(16,185,129,0.1); color: var(--color-on-track); }
    .health-card.at-risk  .health-card-badge { background: rgba(245,158,11,0.1);  color: var(--color-at-risk); }
    .health-card.delayed  .health-card-badge { background: rgba(244,63,94,0.1);   color: var(--color-delayed); }

    .health-card-badge-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      animation: glow-pulse 1.5s infinite;
    }

    .health-card.on-track .health-card-badge-dot { background: var(--color-on-track); }
    .health-card.at-risk  .health-card-badge-dot { background: var(--color-at-risk); }
    .health-card.delayed  .health-card-badge-dot { background: var(--color-delayed); }

    .health-card-times { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }

    .health-time-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
    }

    .health-time-label { color: var(--color-text-muted); }

    .health-time-value {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--color-text-primary);
    }

    .health-buffer {
      font-family: var(--font-display);
      font-size: 1.75rem;
      font-weight: 900;
      margin-bottom: 4px;
    }

    .health-card.on-track .health-buffer { color: var(--color-on-track); }
    .health-card.at-risk  .health-buffer { color: var(--color-at-risk); }
    .health-card.delayed  .health-buffer { color: var(--color-delayed); }

    .health-card-msg { font-size: 0.825rem; color: var(--color-text-secondary); line-height: 1.5; }

    /* ─── Safety Section ─────────────────────────────────────────────── */
    .safety-section {
      background: linear-gradient(160deg, var(--color-surface) 0%, var(--color-bg) 100%);
      padding: 96px 0;
    }

    .safety-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 48px;
    }

    .safety-item {
      padding: 24px;
      background: white;
      border: 1px solid var(--color-border);
      border-radius: 16px;
      box-shadow: var(--shadow-sm);
      transition: all 0.25s;
    }

    .safety-item:hover {
      border-color: var(--color-primary-border);
      box-shadow: var(--shadow-md);
      transform: translateY(-3px);
    }

    .safety-icon {
      font-size: 2rem;
      margin-bottom: 14px;
      display: block;
    }

    .safety-title { font-weight: 700; font-size: 0.95rem; color: var(--color-text-primary); margin-bottom: 6px; }
    .safety-desc  { font-size: 0.83rem; color: var(--color-text-secondary); line-height: 1.6; }

    /* ─── Testimonials ───────────────────────────────────────────────── */
    .testimonials-section { background: white; padding: 96px 0; }

    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 48px;
    }

    .testimonial-card {
      padding: 28px;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 20px;
      position: relative;
      transition: all 0.25s;
    }

    .testimonial-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-3px);
    }

    .testimonial-card::before {
      content: "\201C";
      position: absolute;
      top: 16px; right: 20px;
      font-size: 5rem;
      font-family: Georgia, serif;
      color: rgba(79,70,229,0.08);
      line-height: 1;
    }

    .testimonial-rating { display: flex; gap: 2px; color: var(--color-accent); font-size: 0.875rem; margin-bottom: 12px; }

    .testimonial-text { font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.7; margin-bottom: 20px; font-style: italic; }

    .testimonial-author { display: flex; align-items: center; gap: 12px; }
    .testimonial-author-name  { font-weight: 700; font-size: 0.875rem; }
    .testimonial-author-title { font-size: 0.775rem; color: var(--color-text-muted); }

    /* ─── Driver CTA Section ─────────────────────────────────────────── */
    .driver-section {
      background: linear-gradient(135deg, #4F46E5 0%, #3730A3 100%);
      padding: 80px 0;
      position: relative;
      overflow: hidden;
    }

    .driver-section::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 80% 50%, rgba(251,191,36,0.15), transparent 60%);
    }

    .driver-inner {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .driver-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 900;
      color: white;
      line-height: 1.1;
      letter-spacing: -0.03em;
      margin-bottom: 16px;
    }

    .driver-title span { color: var(--color-accent); }

    .driver-subtitle { color: rgba(255,255,255,0.75); font-size: 1rem; line-height: 1.7; margin-bottom: 28px; }

    .driver-benefits { display: flex; flex-direction: column; gap: 12px; }

    .driver-benefit {
      display: flex;
      align-items: center;
      gap: 10px;
      color: rgba(255,255,255,0.9);
      font-size: 0.9rem;
      font-weight: 500;
    }

    .driver-benefit-check {
      width: 20px; height: 20px;
      background: rgba(16,185,129,0.2);
      border: 1px solid rgba(16,185,129,0.4);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.65rem;
      flex-shrink: 0;
    }

    .driver-stat-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .driver-stat-card {
      background: rgba(255,255,255,0.1);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 16px;
      padding: 20px;
      text-align: center;
    }

    .driver-stat-value {
      font-family: var(--font-display);
      font-size: 2rem;
      font-weight: 900;
      color: white;
    }

    .driver-stat-label { font-size: 0.78rem; color: rgba(255,255,255,0.65); margin-top: 4px; }

    /* ─── Final CTA ──────────────────────────────────────────────────── */
    .cta-section {
      background: linear-gradient(160deg, #F5F3FF 0%, #EEF2FF 100%);
      padding: 96px 0;
      text-align: center;
    }

    .cta-icon {
      font-size: 3.5rem;
      margin-bottom: 16px;
      display: block;
      animation: float 3s ease-in-out infinite;
    }

    .cta-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 900;
      color: var(--color-text-primary);
      letter-spacing: -0.03em;
      margin-bottom: 16px;
    }

    .cta-subtitle { color: var(--color-text-secondary); font-size: 1rem; max-width: 460px; margin: 0 auto 32px; line-height: 1.7; }
    .cta-actions { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }

    /* ─── Responsive ─────────────────────────────────────────────────── */
    @media (max-width: 1024px) {
      .hiw-steps { grid-template-columns: repeat(2, 1fr); gap: 32px; }
      .hiw-steps::before { display: none; }
      .health-cards { grid-template-columns: 1fr; }
      .testimonials-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 768px) {
      body { padding-top: 56px; }
      .hero-inner { grid-template-columns: 1fr; gap: 40px; padding: 48px 16px; }
      .hero-title { font-size: 2.25rem; }
      .booking-widget { padding: 20px; }
      .ji-section .grid-2,
      .driver-inner { grid-template-columns: 1fr; }
      .safety-grid { grid-template-columns: 1fr; }
      .testimonials-grid { grid-template-columns: 1fr; }
      .hiw-steps { grid-template-columns: 1fr; }
      .driver-stat-grid { grid-template-columns: repeat(2, 1fr); }
      .ji-visual { display: none; }
    }
  </style>
</head>
<body>

<!-- ═══════════════════════════════════════════════════════════════
  NAVBAR
════════════════════════════════════════════════════════════════ -->
<nav class="navbar" id="navbar">
  <div class="navbar-inner">
    <a href="/" class="navbar-logo">
      <div class="navbar-logo-mark">🚗</div>
      <span class="navbar-logo-text">Trip<span>Link</span></span>
    </a>

    <ul class="navbar-nav">
      <li><a href="#how-it-works">How It Works</a></li>
      <li><a href="#journey-intelligence">Journey Intel</a></li>
      <li><a href="#services">Services</a></li>
      <li><a href="#safety">Safety</a></li>
      <li><a href="/driver">Drive with Us</a></li>
