      <% } else { %>
        <a href="/auth/login" class="btn btn-ghost btn-sm">Sign In</a>
        <a href="/auth/register" class="btn btn-primary btn-sm">Get Started</a>
      <% } %>
    </div>
  </div>
</nav>

<!-- ═══════════════════════════════════════════════════════════════
  HERO
════════════════════════════════════════════════════════════════ -->
<section class="hero-section">
  <div class="hero-blob-1"></div>
  <div class="hero-blob-2"></div>

  <div class="hero-inner">
    <!-- Left: Copy -->
    <div class="animate-fade-up">
      <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        Journey Intelligence
      </div>

      <h1 class="hero-title">
        Your Ride,<br>
        <span class="accent-line">Our Connection.</span>
      </h1>

      <p class="hero-subtitle">
        Move through your city with confidence. TripLink helps you plan, book and monitor every journey — built around your <strong>arrival time</strong>, not just your destination.
      </p>

      <div class="hero-actions">
        <% if (user) { %>
          <a href="<%= user.role === 'DRIVER' ? '/driver/dashboard' : '/rider/dashboard' %>" class="btn btn-primary btn-lg">
            Go to Dashboard →
          </a>
        <% } else { %>
          <a href="/auth/register" class="btn btn-primary btn-lg">Plan My Journey →</a>
          <a href="/driver" class="btn btn-secondary btn-lg">Become a Driver</a>
        <% } %>
      </div>

      <div class="hero-trust stagger">
        <div class="hero-trust-item animate-fade-in">
          <span class="hero-trust-dot"></span>
          <span>Real-time tracking</span>
        </div>
        <div class="hero-trust-item animate-fade-in">
          <span class="hero-trust-dot"></span>
          <span>Journey Health AI</span>
        </div>
        <div class="hero-trust-item animate-fade-in">
          <span class="hero-trust-dot"></span>
          <span>Secure payments</span>
        </div>
      </div>
    </div>

    <!-- Right: Booking Widget -->
    <div class="animate-scale-in" style="animation-delay: 150ms;">
      <div class="booking-widget" id="bookingWidget">
        <div class="widget-title">Where do you need to be?</div>
        <div class="widget-subtitle">Set your arrival target and we'll plan the rest.</div>

        <div class="widget-fields">
          <!-- Pickup -->
          <div class="widget-field">
            <span class="widget-field-icon">📍</span>
            <input
              type="text"
              class="widget-input"
              id="widgetPickup"
              placeholder="Pickup location"
              autocomplete="off"
            >
          </div>

          <div class="widget-divider">
            <button class="widget-swap-btn" id="swapBtn" title="Swap locations">⇅</button>
          </div>

          <!-- Destination -->
          <div class="widget-field">
            <span class="widget-field-icon">🎯</span>
            <input
              type="text"
              class="widget-input"
              id="widgetDestination"
              placeholder="Destination"
              autocomplete="off"
            >
          </div>

          <!-- Arrival Time -->
          <div style="margin-top: 4px;">
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px;">I need to arrive by</div>
            <div class="widget-time-row">
              <div class="widget-field">
                <span class="widget-field-icon">📅</span>
                <input type="date" class="widget-input" id="widgetDate">
              </div>
              <div class="widget-field">
                <span class="widget-field-icon">🕐</span>
                <input type="time" class="widget-input" id="widgetTime">
              </div>
            </div>
          </div>
        </div>

        <button class="widget-btn" id="planJourneyBtn">
          <span id="planBtnText">Plan My Journey →</span>
          <span id="planBtnSpinner" style="display:none;" class="spinner spinner-sm" style="border-color: rgba(255,255,255,0.3); border-top-color: white;"></span>
        </button>

        <!-- Journey Preview Result -->
        <div class="journey-preview" id="journeyPreview">
          <div class="journey-preview-label">Your Journey Plan</div>
          <div class="journey-preview-grid">
            <div class="jp-chip">
              <div class="jp-chip-label">Pickup by</div>
              <div class="jp-chip-value" id="previewPickupTime">—</div>
            </div>
            <div class="jp-chip">
              <div class="jp-chip-label">Travel time</div>
              <div class="jp-chip-value" id="previewTravelTime">—</div>
            </div>
            <div class="jp-chip">
              <div class="jp-chip-label">Fare estimate</div>
              <div class="jp-chip-value" id="previewFare">—</div>
            </div>
            <div class="jp-chip">
              <div class="jp-chip-label">Buffer</div>
              <div class="jp-chip-value" id="previewBuffer">—</div>
            </div>
          </div>

          <!-- Journey Health Badge -->
          <div class="journey-health on-track" id="previewHealth">
            <div class="journey-health-indicator"></div>
            <div>
              <div class="journey-health-label" id="previewHealthLabel">ON TRACK</div>
              <div class="journey-health-message" id="previewHealthMsg">You are on track to arrive with time to spare.</div>
            </div>
          </div>

          <% if (!user) { %>
          <a href="/auth/register" class="widget-btn" style="margin-top: 12px; text-decoration: none; display: flex;">
            Create Account to Book →
          </a>
          <% } else { %>
          <a href="/rider/dashboard" class="widget-btn" style="margin-top: 12px; text-decoration: none; display: flex;">
            Book This Journey →
          </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
  JOURNEY INTELLIGENCE SECTION
════════════════════════════════════════════════════════════════ -->
<section class="ji-section" id="journey-intelligence">
  <div class="container">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;">
      <!-- Visual -->
      <div class="ji-visual" style="height: 360px;">
        <div class="ji-ring ji-ring-1"></div>
        <div class="ji-ring ji-ring-2"></div>
        <div class="ji-center animate-scale-in">
          <div class="ji-center-time">7:18 PM</div>
          <div class="ji-center-label">Predicted Arrival</div>
        </div>
        <div class="ji-orbit-item ji-orbit-1 animate-fade-in">
          <span class="icon">📍</span>
          <span>Pickup<br>7:00 PM</span>
        </div>
        <div class="ji-orbit-item ji-orbit-2 animate-fade-in" style="animation-delay: 100ms;">
          <span class="icon">🚦</span>
          <span>Traffic<br>Low</span>
        </div>
        <div class="ji-orbit-item ji-orbit-3 animate-fade-in" style="animation-delay: 200ms;">
          <span class="icon">✅</span>
          <span>Buffer<br>+12 min</span>
        </div>
        <div class="ji-orbit-item ji-orbit-4 animate-fade-in" style="animation-delay: 300ms;">
          <span class="icon">🧠</span>
          <span>Confidence<br>91%</span>
        </div>
      </div>

      <!-- Features -->
      <div>
        <div class="section-label">Journey Intelligence</div>
        <h2 class="section-title">Built around your <span class="gradient-text">arrival time.</span></h2>
        <p class="section-subtitle" style="margin-bottom: 32px;">
          TripLink doesn't just ask where you're going. We ask <em>when you need to be there</em> — and intelligently plan backwards from your target arrival.
        </p>

        <div class="ji-features stagger">
          <div class="ji-feature animate-fade-up">
            <div class="ji-feature-icon">🎯</div>
            <div>
              <div class="ji-feature-title">Arrival-First Planning</div>
              <div class="ji-feature-desc">Set your target arrival time. TripLink calculates your optimal pickup window and monitors every minute.</div>
            </div>
          </div>

          <div class="ji-feature animate-fade-up">
            <div class="ji-feature-icon">💚</div>
            <div>
              <div class="ji-feature-title">Live Journey Health</div>
              <div class="ji-feature-desc">Real-time status: ON TRACK, AT RISK, or DELAYED — with clear buffer time and actionable recommendations.</div>
            </div>
          </div>

          <div class="ji-feature animate-fade-up">
            <div class="ji-feature-icon">🔄</div>
            <div>
              <div class="ji-feature-title">Automatic Replanning</div>
              <div class="ji-feature-desc">If traffic surges or a driver cancels, TripLink instantly recalculates and offers concrete alternatives.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
  SERVICES
════════════════════════════════════════════════════════════════ -->
<section class="services-section" id="services">
  <div class="container">
    <div class="text-center" style="margin-bottom: 56px;">
      <div class="section-label" style="margin: 0 auto 16px;">Ride Options</div>
      <h2 class="section-title">Every journey, every vehicle type.</h2>
      <p class="section-subtitle" style="margin: 0 auto;">From a quick auto to a premium sedan — all with Journey Intelligence built in.</p>
    </div>

    <div class="grid-4 stagger">
      <div class="service-card animate-fade-up">
        <span class="service-icon">🛵</span>
        <div class="service-title">Bike</div>
        <div class="service-desc">Fastest option for solo travel. Zip through traffic and beat the clock.</div>
        <div class="service-tag">⚡ Quickest</div>
      </div>

      <div class="service-card animate-fade-up">
        <span class="service-icon">🛺</span>
        <div class="service-title">Auto</div>
        <div class="service-desc">Affordable three-wheeler rides. Perfect for short to medium distances.</div>
        <div class="service-tag">💰 Best Value</div>
      </div>

      <div class="service-card animate-fade-up">
        <span class="service-icon">🚗</span>
        <div class="service-title">Car</div>
        <div class="service-desc">Comfortable sedans with AC. Great for groups and longer journeys.</div>
        <div class="service-tag">⭐ Most Popular</div>
      </div>

      <div class="service-card animate-fade-up">
        <span class="service-icon">🏎️</span>
        <div class="service-title">Premium</div>
        <div class="service-desc">SUVs and luxury cars for when the journey matters as much as the destination.</div>
        <div class="service-tag">👑 Premium</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
  HOW IT WORKS
════════════════════════════════════════════════════════════════ -->
<section class="hiw-section" id="how-it-works">
  <div class="container">
    <div class="text-center">
      <div class="section-label" style="margin: 0 auto 16px;">The TripLink Way</div>
      <h2 class="section-title">From goal to arrival — <span class="gradient-text">in four steps.</span></h2>
    </div>

    <div class="hiw-steps stagger">
      <div class="hiw-step animate-fade-up">
        <div class="hiw-step-number">1</div>
        <div class="hiw-step-icon">📍</div>
        <div class="hiw-step-title">Set Your Destination</div>
        <div class="hiw-step-desc">Enter your pickup and where you're headed. Or let TripLink auto-detect your location.</div>
      </div>

      <div class="hiw-step animate-fade-up">
        <div class="hiw-step-number">2</div>
        <div class="hiw-step-icon">🕐</div>
        <div class="hiw-step-title">Set Arrival Target</div>
        <div class="hiw-step-desc">Tell us when you need to be there. Journey Intelligence plans your ride backwards from that time.</div>
      </div>

      <div class="hiw-step animate-fade-up">
        <div class="hiw-step-number">3</div>
        <div class="hiw-step-icon">🚗</div>
        <div class="hiw-step-title">Get Matched</div>
        <div class="hiw-step-desc">Our matching engine selects the best driver based on location, reliability, and ETA to your pickup.</div>
      </div>

      <div class="hiw-step animate-fade-up">
        <div class="hiw-step-number">4</div>
        <div class="hiw-step-icon">✅</div>
        <div class="hiw-step-title">Track & Arrive</div>
        <div class="hiw-step-desc">Watch your Journey Health live. TripLink monitors every minute and replans if anything changes.</div>
      </div>
    </div>

    <div class="hiw-highlight animate-fade-up" style="max-width: 640px; margin: 40px auto 0;">
      <div class="hiw-highlight-icon">🧠</div>
      <div>
        <div style="font-weight: 700; font-size: 0.95rem; margin-bottom: 4px;">The core TripLink difference</div>
        <div style="font-size: 0.85rem; color: var(--color-text-secondary); line-height: 1.6;">Most apps ask "where are you going?" — TripLink asks "when do you need to arrive?" This single change makes every journey smarter and less stressful.</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
  JOURNEY HEALTH DEMO
════════════════════════════════════════════════════════════════ -->
<section class="health-demo-section">
  <div class="container">
    <div class="text-center" style="margin-bottom: 0;">
      <div class="section-label" style="margin: 0 auto 16px;">Journey Health</div>
      <h2 class="section-title">Always know exactly where you stand.</h2>
      <p class="section-subtitle" style="margin: 0 auto;">Three clear states. No confusion. Real-time monitoring with your arrival target front and center.</p>
    </div>

    <div class="health-cards stagger">
      <!-- ON TRACK -->
      <div class="health-card on-track animate-fade-up">
        <div class="health-card-badge">
          <span class="health-card-badge-dot"></span>
          ON TRACK
        </div>
        <div class="health-card-times">
          <div class="health-time-row">
            <span class="health-time-label">Target arrival</span>
            <span class="health-time-value">7:30 PM</span>
          </div>
          <div class="health-time-row">
            <span class="health-time-label">Predicted arrival</span>
            <span class="health-time-value" style="color: var(--color-on-track);">7:18 PM</span>
          </div>
        </div>
        <div class="health-buffer">+12 min</div>
        <div class="health-card-msg">You are on track to arrive 12 minutes before your target. Keep it up!</div>
      </div>

      <!-- AT RISK -->
      <div class="health-card at-risk animate-fade-up">
        <div class="health-card-badge">
          <span class="health-card-badge-dot"></span>
          AT RISK
        </div>
        <div class="health-card-times">
          <div class="health-time-row">
            <span class="health-time-label">Target arrival</span>
            <span class="health-time-value">7:30 PM</span>
          </div>
          <div class="health-time-row">
            <span class="health-time-label">Predicted arrival</span>
            <span class="health-time-value" style="color: var(--color-at-risk);">7:27 PM</span>
          </div>
        </div>
        <div class="health-buffer">+3 min</div>
        <div class="health-card-msg">Traffic is increasing. Your arrival time is close to your target. Consider upgrading to a faster vehicle.</div>
      </div>

      <!-- DELAYED -->
      <div class="health-card delayed animate-fade-up">
        <div class="health-card-badge">
          <span class="health-card-badge-dot"></span>
          DELAYED
        </div>
        <div class="health-card-times">
          <div class="health-time-row">
            <span class="health-time-label">Target arrival</span>
            <span class="health-time-value">7:30 PM</span>
          </div>
          <div class="health-time-row">
            <span class="health-time-label">Predicted arrival</span>
            <span class="health-time-value" style="color: var(--color-delayed);">7:43 PM</span>
          </div>
        </div>
        <div class="health-buffer">-13 min</div>
        <div class="health-card-msg">You may arrive after your target. TripLink is looking for a faster route and alternative drivers.</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
  SAFETY
════════════════════════════════════════════════════════════════ -->
<section class="safety-section" id="safety">
  <div class="container">
    <div class="text-center" style="margin-bottom: 0;">
      <div class="section-label" style="margin: 0 auto 16px;">Safety First</div>
      <h2 class="section-title">Your safety is our <span class="gradient-text">foundation.</span></h2>
    </div>

    <div class="safety-grid stagger">
      <div class="safety-item animate-fade-up">
        <span class="safety-icon">🔐</span>
        <div class="safety-title">OTP-Verified Rides</div>
        <div class="safety-desc">Every ride begins with a secure OTP shared between you and your driver. No OTP — no start.</div>
      </div>
      <div class="safety-item animate-fade-up">
        <span class="safety-icon">📡</span>
        <div class="safety-title">Live Location Sharing</div>
        <div class="safety-desc">Share your Journey Circle — a live tracking link with trusted contacts for every active trip.</div>
      </div>
      <div class="safety-item animate-fade-up">
        <span class="safety-icon">✅</span>
        <div class="safety-title">Verified Drivers</div>
        <div class="safety-desc">All drivers complete document verification. License, RC, and vehicle documents are reviewed before activation.</div>
      </div>
      <div class="safety-item animate-fade-up">
        <span class="safety-icon">🚨</span>
        <div class="safety-title">Emergency SOS</div>
        <div class="safety-desc">One-tap emergency button in every active ride. Contacts and authorities can be alerted immediately.</div>
      </div>
      <div class="safety-item animate-fade-up">
        <span class="safety-icon">🔒</span>
        <div class="safety-title">Secure Payments</div>
        <div class="safety-desc">Powered by Razorpay. Payments processed server-side. Your card details never touch our servers.</div>
      </div>
      <div class="safety-item animate-fade-up">
        <span class="safety-icon">⭐</span>
        <div class="safety-title">Two-Way Ratings</div>
        <div class="safety-desc">After every ride, both riders and drivers rate each other. Low-rated accounts are reviewed automatically.</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
  TESTIMONIALS
════════════════════════════════════════════════════════════════ -->
<section class="testimonials-section">
  <div class="container">
    <div class="text-center" style="margin-bottom: 0;">
      <div class="section-label" style="margin: 0 auto 16px;">Reviews</div>
      <h2 class="section-title">Riders who trust TripLink.</h2>
    </div>

    <div class="testimonials-grid stagger">
      <div class="testimonial-card animate-fade-up">
        <div class="testimonial-rating">★★★★★</div>
        <div class="testimonial-text">"The Journey Health feature is unlike anything I've used before. I had a flight to catch and TripLink alerted me when traffic picked up — I switched to a bike and made it with 8 minutes to spare."</div>
        <div class="testimonial-author">
          <div class="avatar">PA</div>
          <div>
            <div class="testimonial-author-name">Priya A.</div>
            <div class="testimonial-author-title">Frequent Flyer, Mumbai</div>
          </div>
        </div>
      </div>

      <div class="testimonial-card animate-fade-up">
        <div class="testimonial-rating">★★★★★</div>
