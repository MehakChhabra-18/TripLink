<!-- ═══════════════════════════════════════════════════════════════
  SCRIPTS
════════════════════════════════════════════════════════════════ -->
<script>
// ─── Navbar scroll effect ─────────────────────────────────────
const navbar = document.getElementById('navbar');
window.addEventListener('scroll', () => {
  navbar.classList.toggle('scrolled', window.scrollY > 20);
}, { passive: true });

// ─── Widget: set default date/time ───────────────────────────
(function initWidget() {
  const now  = new Date();
  const date = document.getElementById('widgetDate');
  const time = document.getElementById('widgetTime');

  // Default date = today
  date.value = now.toISOString().slice(0, 10);

  // Default time = now + 90 minutes (a reasonable arrival target)
  const target = new Date(now.getTime() + 90 * 60 * 1000);
  time.value = target.toTimeString().slice(0, 5);
})();

// ─── Swap button ──────────────────────────────────────────────
document.getElementById('swapBtn').addEventListener('click', () => {
  const pickup = document.getElementById('widgetPickup');
  const dest   = document.getElementById('widgetDestination');
  [pickup.value, dest.value] = [dest.value, pickup.value];
});

// ─── Journey Intelligence MVP (transparent rule-based) ────────
/**
 * Estimates travel time using OSRM via the backend fare API.
 * Falls back to a local heuristic if unavailable.
 */
async function estimateJourney(pickup, destination) {
  try {
    const res = await fetch(
      `/ride/fare?pickup=${encodeURIComponent(pickup)}&destination=${encodeURIComponent(destination)}`
    );
    if (!res.ok) throw new Error('Fare API unavailable');
    const data = await res.json();
    return {
      distanceKm:   data.distanceKm || 5,
      estimatedFare: data.estimatedFare || 90,
      durationText:  data.durationText || '18 mins',
      durationMin:   data.durationMin  || 18,
    };
  } catch {
    // Local heuristic fallback
    const km = 5;
    return {
      distanceKm:   km,
      estimatedFare: 30 + km * 12,
      durationText:  '~20 mins',
      durationMin:   20,
    };
  }
}

/**
 * Journey Intelligence Engine (MVP, rule-based)
 * Calculates: recommended pickup, buffer, Journey Health, confidence
 *
 * @param {Date}   targetArrival
 * @param {number} travelMinutes
 * @returns {object}
 */
function calculateJourneyIntelligence(targetArrival, travelMinutes) {
  const DRIVER_MATCH_MIN = 5;    // avg matching wait
  const BUFFER_SAFE_MIN  = 10;   // safe buffer threshold
  const BUFFER_WARN_MIN  = 5;    // warning buffer threshold

  const totalMin         = travelMinutes + DRIVER_MATCH_MIN;
  const recommendedPickup = new Date(targetArrival.getTime() - totalMin * 60 * 1000);
  const predictedArrival  = new Date(recommendedPickup.getTime() + totalMin * 60 * 1000);

  const bufferMin = Math.round((targetArrival - predictedArrival) / 60000);

  let status, confidence, message;

  if (bufferMin >= BUFFER_SAFE_MIN) {
    status     = 'ON_TRACK';
    confidence = Math.min(95, 70 + bufferMin * 2);
    message    = `You are on track to arrive ${bufferMin} minutes before your target.`;
  } else if (bufferMin >= BUFFER_WARN_MIN) {
    status     = 'AT_RISK';
    confidence = Math.max(40, 65 - (BUFFER_SAFE_MIN - bufferMin) * 5);
    message    = `Traffic or delays could push you close to your target arrival time.`;
  } else {
    status     = 'DELAYED';
    confidence = Math.max(20, 50 + bufferMin * 3);
    message    = `You may arrive after your target time. Consider leaving earlier or choosing a faster vehicle.`;
  }

  return {
    recommendedPickup,
    predictedArrival,
    bufferMin,
    status,
    confidence: Math.round(confidence),
    message,
  };
}

function formatTime(date) {
  return date.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true });
}

// ─── Plan Journey Button ──────────────────────────────────────
document.getElementById('planJourneyBtn').addEventListener('click', async () => {
  const pickup      = document.getElementById('widgetPickup').value.trim();
  const destination = document.getElementById('widgetDestination').value.trim();
  const dateVal     = document.getElementById('widgetDate').value;
  const timeVal     = document.getElementById('widgetTime').value;

  if (!pickup || !destination) {
    showToast('⚠️ Missing fields', 'Please enter both pickup and destination.', 'warning');
    return;
  }
  if (!dateVal || !timeVal) {
    showToast('⚠️ Set arrival time', 'Please set the date and time you need to arrive by.', 'warning');
    return;
  }

  const btn     = document.getElementById('planJourneyBtn');
  const btnText = document.getElementById('planBtnText');
  const spinner = document.getElementById('planBtnSpinner');

  btn.disabled = true;
  btnText.textContent = 'Calculating...';
  spinner.style.display = 'inline-block';

  try {
    const { estimatedFare, durationText, durationMin } = await estimateJourney(pickup, destination);

    const targetArrival = new Date(`${dateVal}T${timeVal}`);
    const ji = calculateJourneyIntelligence(targetArrival, durationMin || 20);

    // Populate preview
    document.getElementById('previewPickupTime').textContent  = formatTime(ji.recommendedPickup);
    document.getElementById('previewTravelTime').textContent  = durationText;
    document.getElementById('previewFare').textContent        = `₹${estimatedFare}`;
    document.getElementById('previewBuffer').textContent      = ji.bufferMin >= 0 ? `+${ji.bufferMin} min` : `${ji.bufferMin} min`;

    // Journey Health
    const healthEl    = document.getElementById('previewHealth');
    const healthLabel = document.getElementById('previewHealthLabel');
    const healthMsg   = document.getElementById('previewHealthMsg');

    healthEl.className = 'journey-health ' + ji.status.toLowerCase().replace('_', '-');
    healthLabel.textContent = ji.status.replace('_', ' ');
    healthMsg.textContent   = ji.message;

    // Show preview
    document.getElementById('journeyPreview').classList.add('visible');

  } catch (err) {
    showToast('❌ Error', 'Could not calculate journey. Please try again.', 'error');
    console.error(err);
  } finally {
    btn.disabled = false;
    btnText.textContent = 'Plan My Journey →';
    spinner.style.display = 'none';
  }
});

// ─── Toast system ─────────────────────────────────────────────
function showToast(title, msg, type = 'info') {
  const icons = { success: '✅', warning: '⚠️', error: '❌', info: 'ℹ️' };
  const container = document.getElementById('toastContainer');

  const toast = document.createElement('div');
  toast.className = `toast ${type}`;
  toast.innerHTML = `
    <span class="toast-icon">${icons[type] || 'ℹ️'}</span>
    <div>
      <div class="toast-title">${title}</div>
      ${msg ? `<div class="toast-msg">${msg}</div>` : ''}
    </div>
  `;

  container.appendChild(toast);
  setTimeout(() => {
    toast.style.opacity = '0';
    toast.style.transition = 'opacity 0.3s';
    setTimeout(() => toast.remove(), 300);
  }, 4500);
}

// ─── Scroll-triggered animations ─────────────────────────────
const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.style.animationPlayState = 'running';
      entry.target.classList.add('in-view');
    }
  });
}, { threshold: 0.1 });

document.querySelectorAll('.animate-fade-up, .animate-scale-in, .animate-fade-in').forEach(el => {
  el.style.animationPlayState = 'paused';
  observer.observe(el);
});
</script>

