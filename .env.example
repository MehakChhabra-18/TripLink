# ============================================================
# TripLink Backend — Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git

# ─── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── PostgreSQL (Legacy — being migrated to Firestore) ────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/triplink?schema=public

# ─── JWT Authentication (Legacy — being migrated to Firebase Auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-64-characters
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-64-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ════════════════════════════════════════════════════════════════
# FIREBASE CONFIGURATION (TARGET ARCHITECTURE)
# ════════════════════════════════════════════════════════════════

# ─── Firebase Client Config (PUBLIC — safe to expose to browser)
# Get these from: Firebase Console → Project Settings → General → Your Apps
# These are NOT secrets. They are project identifiers.
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# ─── Firebase Admin SDK (PRIVATE — NEVER expose to browser)
# Option A: Base64-encoded service account JSON (for production/Render)
#   1. Firebase Console → Project Settings → Service Accounts → Generate new private key
#   2. Save the JSON file (service-account.json)
#   3. Encode: node -e "const fs=require('fs'); console.log(Buffer.from(fs.readFileSync('service-account.json')).toString('base64'))"
#   4. Paste the output here
FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50...

# Option B: Path to service account JSON file (for local development)
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# (Never commit service-account.json — it's in .gitignore)

# ─── Firebase Emulator (local development)
# Run: firebase emulators:start
# Uncomment to use local emulators instead of production Firebase:
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
# FIREBASE_DATABASE_EMULATOR_HOST=localhost:9000

# ════════════════════════════════════════════════════════════════
# PAYMENT PROVIDERS
# ════════════════════════════════════════════════════════════════

# ─── Razorpay ─────────────────────────────────────────────────
# Get keys at: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Stripe (Future) ──────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ════════════════════════════════════════════════════════════════
# OTHER SERVICES
# ════════════════════════════════════════════════════════════════

# ─── Cloudinary (Legacy — migrating to Firebase Storage) ──────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# ─── Google Maps ──────────────────────────────────────────────
# Enable: Maps JS API, Directions API, Distance Matrix API
GOOGLE_MAPS_API=AIzaSy...

# ─── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:3000

# ─── Docker Compose ───────────────────────────────────────────
POSTGRES_USER=triplink
POSTGRES_PASSWORD=secret
POSTGRES_DB=triplink
