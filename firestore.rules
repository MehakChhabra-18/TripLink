rules_version = '2';

/**
 * TripLink Firestore Security Rules
 * ─────────────────────────────────────────────────────────────────────────────
 * PRINCIPLES:
 *   1. Default deny — no rule = no access
 *   2. Roles enforced by Custom Claims (set via Cloud Functions / Admin SDK)
 *      Never trust client-supplied role fields for privileged operations
 *   3. Riders only see their own data
 *   4. Drivers only see rides assigned/offered to them + passenger info for active rides
 *   5. Admins have read access via Custom Claim — write operations via Cloud Functions only
 *
 * CUSTOM CLAIMS STRUCTURE (set via Firebase Admin SDK):
 *   token.role = 'RIDER' | 'DRIVER' | 'ADMIN'
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ──────────────────────────────────────────────────────

    // Is the user authenticated?
    function isAuthed() {
      return request.auth != null;
    }

    // Is the request from this specific user?
    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // Role checks from Custom Claims (set server-side)
    function hasRole(role) {
      return isAuthed() && request.auth.token.role == role;
    }

    function isRider()  { return hasRole('RIDER'); }
    function isDriver() { return hasRole('DRIVER'); }
    function isAdmin()  { return hasRole('ADMIN'); }

    // Is the request creating a new document?
    function isCreating() { return request.resource.data != null && resource == null; }

    // Ensure a field has not changed
    function fieldUnchanged(field) {
      return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
    }

    // ─── users/{uid} ──────────────────────────────────────────────────────────
    // Users can read/write their own profile.
    // Admins can read any profile.
    // Role field is read-only after creation (only Cloud Functions can change it).
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.role in ['RIDER', 'DRIVER'];
      allow update: if isOwner(uid)
                    // Prevent client-side role escalation
                    && fieldUnchanged('role')
                    && fieldUnchanged('uid');
      allow delete: if false; // Soft-delete only, via Cloud Functions
    }

    // ─── drivers/{driverId} ───────────────────────────────────────────────────
    // Drivers can read/write their own driver profile.
    // Admins can read all. Verification status changed only by Cloud Functions.
    match /drivers/{driverId} {
      allow read:   if isOwner(driverId) || isAdmin();
      allow create: if isOwner(driverId)
                    && request.resource.data.userId == driverId
                    // New drivers start as OFFLINE with PENDING verification
                    && request.resource.data.availabilityStatus == 'OFFLINE'
                    && request.resource.data.verificationStatus == 'PENDING';
      allow update: if isOwner(driverId)
                    // Drivers can update availability status themselves
                    && request.resource.data.userId == driverId
                    // Verification status can only be changed by Cloud Functions (Admin SDK)
                    && fieldUnchanged('verificationStatus')
                    && fieldUnchanged('rating')
                    && fieldUnchanged('totalTrips');
    }

    // ─── vehicles/{vehicleId} ─────────────────────────────────────────────────
    match /vehicles/{vehicleId} {
      // Driver who owns the vehicle can read it; admin can read all
      allow read:   if isDriver() && resource.data.driverId == request.auth.uid
                    || isAdmin();
      allow create: if isDriver()
                    && request.resource.data.driverId == request.auth.uid
                    && request.resource.data.verificationStatus == 'PENDING';
      allow update: if isDriver()
                    && resource.data.driverId == request.auth.uid
                    // Verification status changed only by Cloud Functions
                    && fieldUnchanged('verificationStatus');
      allow delete: if false;
    }

    // ─── rides/{rideId} ───────────────────────────────────────────────────────
    // Rides are sensitive — state transitions enforced server-side.
    // Clients can only CREATE a ride (REQUESTING state).
    // All status transitions must go through Cloud Functions.
    match /rides/{rideId} {
      // Rider can read their own rides
      allow read: if isRider() && resource.data.riderId == request.auth.uid
                  // Driver can read rides assigned to them or currently searching
                  || isDriver() && (
                    resource.data.driverId == request.auth.uid
                    || resource.data.status == 'SEARCHING'
                  )
                  || isAdmin();

      // Riders can create rides in REQUESTED state only
      allow create: if isRider()
                    && request.resource.data.riderId == request.auth.uid
                    && request.resource.data.status == 'REQUESTED'
                    && request.resource.data.driverId == null;

      // Status transitions only allowed via Cloud Functions (uses Admin SDK).
      // Clients cannot directly update ride status.
      allow update: if false;
      allow delete: if false;
    }

    // ─── rideRequests/{requestId} ─────────────────────────────────────────────
    // Ride request broadcast documents. Drivers can read all active requests.
    match /rideRequests/{requestId} {
      allow read:   if isDriver() || isAdmin();
      allow create: if isRider();          // Created by rider initiating a ride
      allow update: if false;              // Updated only by Cloud Functions
      allow delete: if false;
    }

    // ─── journeys/{journeyId} ─────────────────────────────────────────────────
    match /journeys/{journeyId} {
      allow read:   if isRider() && resource.data.riderId == request.auth.uid
                    || isAdmin();
      allow create: if isRider()
                    && request.resource.data.riderId == request.auth.uid;
      allow update: if false; // Journey updates via Cloud Functions only
      allow delete: if false;

      // Journey events subcollection
      match /events/{eventId} {
        allow read:   if isRider() && get(/databases/$(database)/documents/journeys/$(journeyId)).data.riderId == request.auth.uid
                      || isAdmin();
        allow create: if false; // Events created only by Cloud Functions
        allow update: if false;
        allow delete: if false;
      }
    }

    // ─── payments/{paymentId} ─────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read:   if isRider() && resource.data.riderId == request.auth.uid
                    || isDriver() && resource.data.driverId == request.auth.uid
                    || isAdmin();
      // Payment documents created and updated only by Cloud Functions
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─── ratings/{ratingId} ───────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read:   if isAuthed();
      // Ratings created only after ride completion via Cloud Function
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─── notifications/{uid}/items/{notifId} ──────────────────────────────────
    match /notifications/{uid}/items/{notifId} {
      allow read:   if isOwner(uid);
      allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if false; // Notifications created by Cloud Functions only
      allow delete: if isOwner(uid);
    }

    // ─── savedPlaces/{uid}/places/{placeId} ───────────────────────────────────
    match /savedPlaces/{uid}/places/{placeId} {
      allow read:   if isOwner(uid);
      allow write:  if isOwner(uid);
    }

    // ─── supportTickets/{ticketId} ────────────────────────────────────────────
    match /supportTickets/{ticketId} {
      allow read:   if isAuthed() && resource.data.userId == request.auth.uid
                    || isAdmin();
      allow create: if isAuthed()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'OPEN';
      allow update: if false; // Updated by support staff via Cloud Functions
      allow delete: if false;
    }

    // ─── adminLogs/{logId} ────────────────────────────────────────────────────
    // Admin audit log — read-only for admins, written only by Cloud Functions
    match /adminLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─── driverLocations/{driverId} ───────────────────────────────────────────
    // Public read for nearby driver display; writes only by verified drivers
    // NOTE: High-frequency location updates go to Realtime Database, not here.
    // This collection stores the LAST KNOWN position for matching purposes.
    match /driverLocations/{driverId} {
      allow read:   if isAuthed();
      allow write:  if isDriver() && driverId == request.auth.uid;
    }

  }
}
